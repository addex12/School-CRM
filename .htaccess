# Optimize: Place HTTPS and typo-domain redirect rules BEFORE the main rewrite to index.php
RewriteEngine On

# Redirect typo domain to correct domain immediately (before any other rewrite)
RewriteCond %{HTTP_HOST} ^crm\.flipperschools\.com$ [NC]
RewriteRule ^ https://crm.flipperschool.com%{REQUEST_URI} [L,R=301]

# Force HTTPS for all requests (except already HTTPS)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Main rewrite for pretty URLs (after above redirects)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Prevent directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Cache control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/* "access plus 1 year"
</IfModule>

# Protect sensitive files
<FilesMatch "^(db\.php|config\.php|\.htaccess|\.env)$">
    Order allow,deny
    Deny from all
</FilesMatch>
