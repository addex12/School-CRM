RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Force HTTPS and redirect crm.flipperschool.com and crm.flipperschools.com to flipperschool.com/login.php
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^crm\.flipperschool\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^crm\.flipperschools\.com$ [NC]
RewriteRule ^(.*)$ https://flipperschool.com/login.php [L,R=301]

# Prevent directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Cache control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/* "access plus 1 year"
</IfModule>

# Protect sensitive files
<FilesMatch "^(db\.php|config\.php|\.htaccess|\.env)$">
    Order allow,deny
    Deny from all
</FilesMatch>
